# Copier ce fichier en .env puis adapter les valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore).

# Domaine racine : les services seront servis sur
#   grafana.<DOMAIN>, vpn.<DOMAIN>, dns.<DOMAIN>, traefik.<DOMAIN>
# Chaque sous-domaine doit pointer (enregistrement A) vers l'IP publique de l'hôte.
DOMAIN=example.com

# E-mail utilisé pour les certificats Let's Encrypt
ACME_EMAIL=admin@example.com

# Serveur ACME : décommenter la ligne staging pour tester sans atteindre
# les limites de Let's Encrypt (certificats non reconnus par les navigateurs)
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Adresse publique (IP ou nom DNS) que les clients WireGuard utiliseront
WG_HOST=vpn.example.com

# Ports publiés sur l'hôte. À changer seulement s'ils sont déjà utilisés
# (en local par exemple : HTTPS_PORT=8443, WG_PORT=51830).
# En production, garde 443 : Let's Encrypt valide le domaine sur ce port.
HTTPS_PORT=443
WG_PORT=51820

# Identifiants d'administration (les mots de passe sont générés dans secrets/)
WG_ADMIN_USER=admin
GRAFANA_ADMIN_USER=admin
ADGUARD_ADMIN_USER=admin
TRAEFIK_ADMIN_USER=admin
