# Copy this file to .env, then adjust the values.
# .env is never committed (see .gitignore).

# Root domain: services are served on
#   grafana.<DOMAIN>, vpn.<DOMAIN>, dns.<DOMAIN>, traefik.<DOMAIN>
# Each subdomain must point (A record) to the host's public IP.
DOMAIN=example.com

# Email used for Let's Encrypt certificates
ACME_EMAIL=admin@example.com

# ACME server: uncomment the staging line to test without hitting
# Let's Encrypt rate limits (certificates are not trusted by browsers)
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Public address (IP or DNS name) WireGuard clients will connect to
WG_HOST=vpn.example.com

# Ports published on the host. Change them only if already in use
# (locally, e.g. HTTPS_PORT=8443, WG_PORT=51830).
# In production keep 443: Let's Encrypt validates the domain on that port.
HTTPS_PORT=443
WG_PORT=51820

# Admin usernames (passwords are generated in secrets/)
WG_ADMIN_USER=admin
GRAFANA_ADMIN_USER=admin
ADGUARD_ADMIN_USER=admin
TRAEFIK_ADMIN_USER=admin
